---
// Header.astro
---
<header class="mb-header-mb flex justify-between items-center">
  <h1 class="text-logo font-black tracking-tight uppercase">TIME</h1>
  
  <div class="flex items-center gap-tray-gap">
    <button id="format-toggle" class="flex items-center gap-[0.35rem] bg-transparent border border-border-primary text-text-muted py-format-btn-py px-format-btn-px rounded-pill cursor-pointer font-base text-format-btn font-semibold tracking-wide transition-all duration-300 ease-out-expo leading-none" aria-label="Toggle 12/24 hour format" title="Toggle 12/24 hour format">
      <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span id="format-label" class="tabular-nums">12H</span>
    </button>
    
    <label class="relative inline-block w-[56px] h-[30px] cursor-pointer max-[600px]:w-[48px] max-[600px]:h-[26px]" aria-label="Toggle light/dark theme">
      <input type="checkbox" id="theme-toggle-input" class="peer opacity-0 w-0 h-0 absolute" />
      <span class="absolute cursor-pointer inset-0 bg-surface-primary border border-border-primary transition-all duration-400 ease-spring flex items-center justify-between px-[5px] rounded-switch">
        <!-- Sun Icon -->
        <svg class="text-text-muted z-10" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <!-- Moon Icon -->
        <svg class="text-text-muted z-10" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </span>
      <!-- Toggle switch circle (the pseudo element before) -->
      <span class="absolute h-[22px] w-[22px] left-[3px] bottom-[3px] bg-text-primary rounded-circle transition-all duration-400 ease-spring z-20 peer-checked:translate-x-[26px] peer-checked:bg-accent max-[600px]:h-[18px] max-[600px]:w-[18px] max-[600px]:peer-checked:translate-x-[22px]"></span>
    </label>
  </div>
</header>
